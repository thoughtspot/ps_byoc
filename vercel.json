{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "headers": [{
    "source": "/(.*)",
    "headers": [{
      "key": "Content-security-policy",
      "value": "default-src 'self'; frame-ancestors *; form-action 'self'"
    }]
  }]
}
